authors: ["Bhavdeep Dhanjal<bhavdeep@hey.com>"]
license: "MIT"
homepage: "https://github.com/alivenotions/nbascii"
bug-reports: "https://github.com/alivenotions/nbascii/issues"
depends: [
  "ocaml" {>= "5.5.2"}
  "dune" {>= "3.24.2"}
  "eio" {>= "1.6"}
  "eio_main" {>= "1.6"}
  "cohttp-eio" {>= "6.3.0"}
